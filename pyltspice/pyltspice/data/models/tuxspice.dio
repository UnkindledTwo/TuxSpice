* 5 mm indicator LEDs (Vf at 20 mA: red 2.0, yellow 2.05, green 2.2, blue and white 3.1)
.model LED_RED D(IS=2.2E-18 N=2 RS=5 CJO=30p BV=5 IBV=10u Iave=30m Vpk=5 mfg=Generic type=LED)
.model LED_YELLOW D(IS=8.4E-19 N=2 RS=5 CJO=30p BV=5 IBV=10u Iave=30m Vpk=5 mfg=Generic type=LED)
.model LED_GREEN D(IS=4.6E-20 N=2 RS=5 CJO=30p BV=5 IBV=10u Iave=30m Vpk=5 mfg=Generic type=LED)
.model LED_BLUE D(IS=6.4E-22 N=2.5 RS=10 CJO=30p BV=5 IBV=10u Iave=30m Vpk=5 mfg=Generic type=LED)
.model LED_WHITE D(IS=6.4E-22 N=2.5 RS=10 CJO=30p BV=5 IBV=10u Iave=30m Vpk=5 mfg=Generic type=LED)
